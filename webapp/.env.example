# Copy this file to webapp/.env and fill in real values before deploying.
# Never commit the real .env file (it's already in .gitignore).

# SMTP relay -- works with Google Workspace, Microsoft 365, or a
# transactional email provider's SMTP endpoint (SendGrid, Postmark, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@assaflex.com
SMTP_PASSWORD=your-app-password-or-api-key
SMTP_FROM=bearing-designs@assaflex.com

# Comma-separated recipient lists.
ENGINEERING_EMAILS=engineering@assaflex.com
SALES_EMAILS=sales@assaflex.com

# The real assaflex.com domain(s) the form is embedded on. Comma-separated
# if you have both a production and staging domain.
ALLOWED_ORIGINS=https://www.assaflex.com

# Optional: path to a real manufacturing catalog JSON (see
# bearing_tool/catalog.py's Catalog.to_json/from_json). Leave blank to use
# the built-in placeholder defaults.
CATALOG_PATH=

# Optional: a shared secret that lets a visitor see the computed design
# directly on the page instead of routing it to engineering/sales for
# review (see the form's "I have an access code" option). Leave blank to
# disable this entirely -- any code typed into the form is then always
# rejected, rather than silently matching an empty string. Whoever should
# be able to bypass review (AssaFlex staff, a trusted distributor) needs to
# be told this value out of band; it is never shown anywhere in the UI.
DESIGN_ACCESS_CODE=
